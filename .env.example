# PostgreSQL
PG_USER=n8n_admin
PG_PASS=<generate-strong-password>

# n8n
N8N_ENCRYPTION_KEY=<generate-32-char-random-string>
TZ=America/New_York

# WAHA (WhatsApp)
WAHA_API_KEY=<generate-uuid>
WAHA_HMAC_SECRET=<generate-uuid>
WAHA_DASH_USER=admin
WAHA_DASH_PASS=<generate-strong-password>

# App (Electron HTTP listener port for webhooks)
APP_PORT=4000

# Ollama (runs on Windows host, not in Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Qdrant
QDRANT_URL=http://qdrant:6333

# MCP server API keys (fill in as needed)
BRAVE_API_KEY=
GITHUB_PAT=
STRIPE_KEY=
NOTION_CLIENT_ID=
MONGO_URI=
